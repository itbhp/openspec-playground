<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EmployeeApi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- EF Core installed from the start, ready for Act 2 (MySQL migration) -->
